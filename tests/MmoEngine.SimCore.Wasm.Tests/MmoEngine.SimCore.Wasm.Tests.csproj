         tables/config.bin). The host never references the server helpers. -->
    <ProjectReference Include="..\..\src\MmoEngine.SimCore.Server\MmoEngine.SimCore.Server.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\MmoEngine.SimCore.Tests\Support\RepoPaths.cs" Link="Support\RepoPaths.cs" />
  </ItemGroup>
</Project>
